{
  "name": "namma-appeal-enterprise-test-automation",
  "version": "1.0.0",
  "description": "Enterprise E2E Mobile Appium, Web Selenium/Playwright, k6 Load, and OWASP ZAP Security Test Suite for Namma-Appeal Hybrid Flutter Application",
  "main": "runner.js",
  "scripts": {
    "test": "node runner.js",
    "test:mobile": "node runner.js --quadrant=mobile",
    "test:web": "node runner.js --quadrant=web",
    "test:load": "node runner.js --quadrant=load",
    "test:security": "node runner.js --quadrant=security",
    "generate:report": "node utils/excelReporter.js"
  },
  "keywords": [
    "appium",
    "selenium",
    "flutter",
    "k6",
    "owasp-zap",
    "exceljs",
    "mochawesome",
    "e2e",
    "security-testing",
    "load-testing"
  ],
  "author": "Namma-Appeal Enterprise QA Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "playwright": "^1.44.1",
    "selenium-webdriver": "^4.21.0",
    "webdriverio": "^8.38.2",
    "winston": "^3.13.0"
  }
}
